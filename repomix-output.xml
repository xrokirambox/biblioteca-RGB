    ],
  },
];

export const getNivelById = (id) => NIVELES.find((n) => n.id === id);
export const getGradoById = (gradoId) => {
  for (const n of NIVELES) {
    const g = n.grados.find((x) => x.id === gradoId);
    if (g) return { ...g, nivel: n };
  }
  return null;
};
