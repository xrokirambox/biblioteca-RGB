%;\n  --popover: 150 60% 5%;\n  --popover-foreground: 45 40% 92%;\n  --primary: 45 70% 47%;\n  --primary-foreground: 150 70% 4%;\n  --secondary: 150 40% 10%;\n  --secondary-foreground: 45 40% 92%;\n  --muted: 150 20% 12%;\n  --muted-foreground: 140 10% 65%;\n  --accent: 45 70% 47%;\n  --accent-foreground: 150 70% 4%;\n  --destructive: 0 62% 40%;\n  --destructive-foreground: 0 0% 98%;\n  --border: 45 40% 20%;\n  --input: 150 30% 10%;\n  --ring: 45 70% 47%;\n  --radius: 0.5rem;\n}\n\nhtml, body {\n  background-color: #020b04;\n  color: #f4f1e1;\n}\n\nbody {\n  margin: 0;\n  font-family: 'DM Sans', system-ui, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  background-image:\n    radial-gradient(1200px 600px at 80% -10%, rgba(201,162,39,0.10), transparent 60%),\n    radial-gradient(900px 500px at -10% 30%, rgba(10,46,18,0.8), transparent 60%),\n    linear-gradient(180deg, #020b04 0%, #051a09 100%);\n  background-attachment: fixed;\n  min-height: 100vh;\n}\n\n* { border-color: hsl(var(--border)); }\n\n::selection {\n  background: rgba(201, 162, 39, 0.35);\n  color: #fff;\n}\n\n/* Custom scrollbar */\n.custom-scrollbar::-webkit-scrollbar { width: 8px; }\n.custom-scrollbar::-webkit-scrollbar-track { background: rgba(0,0,0,0.25); border-radius: 4px; }\n.custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(201,162,39,0.35); border-radius: 4px; }\n.custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(201,162,39,0.6); }\n\n/* Glassmorphism card */\n.glass {\n  background: rgba(255, 255, 255, 0.02);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid rgba(201, 162, 39, 0.15);\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);\n}\n.glass-strong {\n  background: rgba(5, 26, 9, 0.6);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(201, 162, 39, 0.2);\n}\n\n/* Grain overlay */\n.grain::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: 0.06;\n  mix-blend-mode: overlay;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.6'/></svg>\");\n}\n\n.gold-text {\n  color: #c9a227;\n  text-shadow: 0 0 20px rgba(201,162,39,0.25);\n}\n\n.btn-gold {\n  background: #c9a227;\n  color: #020b04;\n  transition: all .25s ease;\n  box-shadow: 0 0 20px rgba(201,162,39,0.25);\n}\n.btn-gold:hover { background: #b08d22; transform: translateY(-1px); box-shadow: 0 0 28px rgba(201,162,39,0.45); }\n\n.btn-outline-gold {\n  background: transparent;\n  color: #c9a227;\n  border: 1px solid rgba(201,162,39,0.6);\n  transition: all .25s ease;\n}\n.btn-outline-gold:hover { background: rgba(201,162,39,0.12); border-color: #c9a227; }\n\n/* Divider */\n.divider-gold {\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(201,162,39,0.5), transparent);\n}\n\n[data-debug-wrapper=\"true\"] { display: contents !important; }\n","/* App-specific overrides */\n.App { min-height: 100vh; }\n"],"names":[],"sourceRoot":""}
